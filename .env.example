# 🔗 LINK Configuration Example
# Copy this file to .env and fill in your values

# --- Discord Bot Settings ---
# Your Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_token_here

# --- ComfyUI Settings ---
# The URL where your ComfyUI is running (include http://)
COMFY_URL=http://127.0.0.1:8188

# --- Database Settings ---
# Path to the SQLite database
DATABASE_URL=sqlite:///data/link.db

# --- Lockdown Settings (Optional) ---
# If set, the bot will only respond in this server/channel
ALLOWED_GUILD_ID=
ALLOWED_CHANNEL_ID=

# --- HuggingFace Settings ---
# Required to download gated models (e.g. FLUX.1-dev, ae.safetensors).
# Get your token at: https://huggingface.co/settings/tokens
# You must also accept each gated model's license on its HuggingFace repo page.
HF_TOKEN=

# --- Logging ---
LOG_LEVEL=INFO

# --- API Security --- (only needed if you want to expose to internet)
API_KEY=

# --- Discord Activity (Inpainting) ---
INPAINT_SERVER_DOMAIN=aidigitalcreations.com
INPAINT_SERVER_PORT=8000
